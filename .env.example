# Скопируйте этот файл в .env и заполните своими значениями.
# Строку подключения возьмите в панели Neon: Dashboard -> Connection Details
# (используйте "Pooled connection" строку, она обычно уже содержит sslmode=require).
# ВАЖНО: замените user / password / dbname на реальные значения из панели Neon —
# заглушки не подойдут (будет "password authentication failed for user").
#
# Если между приложением и интернетом стоит корпоративный TLS-прокси (DLP),
# приложение само отключает SCRAM channel binding (см. common.py), чтобы не
# падать с ошибкой "insecure connection: secure channel data mismatch".
DATABASE_URL=postgresql://user:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require

# Логин/пароль для входа в приложение
APP_USERNAME=admin
APP_PASSWORD=changeme

# Секретный ключ для хеширования токена аутентификации (генерируется
# автоматически при запуске, если не задан). Можно задать фиксированное
# значение, чтобы сессия не сбрасывалась при перезапуске приложения.
# AUTH_SECRET=your-secret-here

# Ключ API DeepSeek (https://platform.deepseek.com) — нужен для раздела
# "ИИ-ассистент" (прогноз баллов подрядчика по будущему конкурсу).
DEEPSEEK_API_KEY=
